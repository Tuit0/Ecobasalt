# ─────────────────────────────────────────────────
# Basalt UZ — Environment Variables
# Ushbu faylni .env nomi bilan nusxalang va o'z qiymatlaringizni kiriting
# cp .env.example .env
# ─────────────────────────────────────────────────

# ─── Database ───
# SQLite ishlatiladi — fayl /app/data/basalt.db ichida (docker volume)
# Boshqa DB ishlatish uchun shu o'zgaruvchini almashtiring (masalan postgresql+asyncpg://...)
# DATABASE_URL=sqlite+aiosqlite:////app/data/basalt.db

# ─── Backend ───
# JWT uchun maxfiy kalit — uzun va tasodifiy bo'lsin (kamida 32 belgi)
# Yaratish: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-make-it-long-and-random-at-least-32-chars

# Admin paneliga kirish uchun
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── Telegram bot ───
# @BotFather orqali yangi bot yarating va token oling
TELEGRAM_BOT_TOKEN=
# Sizning Telegram chat ID — yangi arizalar shu yerga keladi
# @userinfobot orqali o'z ID'ingizni bilib oling
TELEGRAM_ADMIN_CHAT_ID=

# ─── Yuklash limitlari ───
MAX_UPLOAD_SIZE_MB=10

# ─── CORS (vergul bilan ajratilgan) ───
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost

# ─── Portlar ───
HTTP_PORT=80
FRONTEND_PORT=3000
ADMIN_PORT=3001
BACKEND_PORT=8000
