# ─────────────────────────────────────────────────
# ECO BASALT — Environment Variables
# Nusxa olish: cp .env.example .env
# ─────────────────────────────────────────────────

# ─── Domain (production) ───
# Server'ga deploy paytida o'z domeningizni yozing.
# Frontend SEO meta uchun NEXT_PUBLIC_SITE_URL ishlatiladi.
DOMAIN=ecobasalt.uz
NEXT_PUBLIC_SITE_URL=https://ecobasalt.uz

# ─── Database ───
# SQLite default. Boshqa DB uchun ushbu o'zgaruvchini almashtiring.
# DATABASE_URL=sqlite+aiosqlite:////app/data/basalt.db

# ─── Backend secret ───
# JWT kalit (kamida 32 belgi tasodifiy)
# Yaratish: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-make-it-long-and-random-at-least-32-chars

# ─── Admin paneli login ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── Telegram bot ───
# @BotFather → token
TELEGRAM_BOT_TOKEN=
# @userinfobot → o'z chat ID
TELEGRAM_ADMIN_CHAT_ID=

# ─── Yuklash limitlari ───
MAX_UPLOAD_SIZE_MB=10

# ─── CORS (vergul bilan) ───
# Production: o'z domeningizni qo'shing
CORS_ORIGINS=http://localhost:7001,http://localhost:7002,https://ecobasalt.uz,https://admin.ecobasalt.uz,https://api.ecobasalt.uz

# ─── Portlar (host machine'da band qilinadigan portlar) ───
# Container ichida portlar 8000/3000/3001 (o'zgartirilmaydi)
BACKEND_PORT=7000      # API
FRONTEND_PORT=7001     # Frontend (asosiy sayt)
ADMIN_PORT=7002        # Admin panel

# Nginx ixtiyoriy (faqat `--profile with-nginx` bilan ishga tushadi)
HTTP_PORT=7080
